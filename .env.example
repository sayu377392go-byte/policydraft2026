# サイトの URL(メール確認のリダイレクト先などに使用)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase(未設定ならデモモードで起動し、架空データを表示します)
# Supabase CLI の config push 用(= <NEXT_PUBLIC_SITE_URL>/auth/callback)
SUPABASE_AUTH_REDIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用。Stripe Webhook と銀行振込申請の処理で使用。絶対に公開しないこと
SUPABASE_SERVICE_ROLE_KEY=

# Stripe(政治家向けプラン)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=   # 月額 4,400円(税込)の Price ID
STRIPE_PRICE_YEARLY=    # 年額 50,000円(税込)の Price ID
STRIPE_PORTAL_CONFIGURATION=   # 任意: カスタマーポータル設定の ID(未設定ならデフォルト設定)

# 銀行振込先(政治家のプラン画面に表示)
BANK_NAME=
BANK_BRANCH=
BANK_ACCOUNT_TYPE=普通
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_HOLDER=
